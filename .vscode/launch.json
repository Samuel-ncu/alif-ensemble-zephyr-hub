{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "E8 Blinky Debug (M55_HP)",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/out/blinky/DevKit-E8-HP/debug/blinky.elf",
            "request": "launch",
            "type": "cortex-debug",
            "servertype": "jlink",
            "device": "AE722F80F55D5_HP",
            "interface": "jtag",
            "runToEntryPoint": "main",
            "showDevDebugOutput": "parsed",
            "serverpath": "C:/Program Files/SEGGER/JLink/JLinkGDBServerCL.exe",
            "armToolchainPath": "C:/Program Files (x86)/Arm GNU Toolchain arm-none-eabi/12.2 mpacbti-rel1/bin",
            "serverArgs": [
                "-JLinkDevicesXmlPath",
                "${workspaceFolder}/.alif/JLinkDevices.xml"
            ],
            "preLaunchCommands": [
                "monitor speed 4000"
            ],
            "postLaunchCommands": [
                "set $sp = __Vectors[0]",
                "set $pc = __Vectors[1]",
                "set *0xe000ed08 = __Vectors"
            ]
        },
        {
            "name": "E8 Blinky Debug (M55_HE)",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/out/blinky/DevKit-E8-HE/debug/blinky.elf",
            "request": "launch",
            "type": "cortex-debug",
            "servertype": "jlink",
            "device": "AE722F80F55D5_HE",
            "interface": "jtag",
            "runToEntryPoint": "main",
            "showDevDebugOutput": "parsed",
            "serverpath": "C:/Program Files/SEGGER/JLink/JLinkGDBServerCL.exe",
            "armToolchainPath": "C:/Program Files (x86)/Arm GNU Toolchain arm-none-eabi/12.2 mpacbti-rel1/bin",
            "serverArgs": [
                "-JLinkDevicesXmlPath",
                "${workspaceFolder}/.alif/JLinkDevices.xml"
            ],
            "preLaunchCommands": [
                "monitor speed 4000"
            ],
            "postLaunchCommands": [
                "set $sp = __Vectors[0]",
                "set $pc = __Vectors[1]",
                "set *0xe000ed08 = __Vectors"
            ]
        },
        {
            "name": "M55_HE JLink (launch)",
            "type": "gdbtarget",
            "request": "launch",
            "cwd": "${workspaceFolder}/",
            "program": "out/blinky/DevKit-E8-HE/debug/blinky.elf",
            "gdb": "arm-none-eabi-gdb",
            "auxiliaryGdb": true,
            "preLaunchTask": "CMSIS Load",
            "initCommands": [
                "monitor reset 0",
                "tbreak main",
                ""
            ],
            "customResetCommands": [
                "monitor reset 0",
                "maintenance flush register-cache",
                "maintenance flush dcache",
                "tbreak main",
                "continue"
            ],
            "target": {
                "server": "JLinkGDBServerCL.exe",
                "serverParameters": [
                    "-device",
                    "AE822FA0E5597LS0_M55_HE",
                    "-endian",
                    "little",
                    "-if",
                    "swd",
                    "-speed",
                    "4000",
                    "-halt",
                    "-noir",
                    "-vd",
                    "-nogui",
                    "-localhostonly",
                    "-silent",
                    "-port",
                    "3333",
                    "-TelnetPort",
                    "4444"
                ],
                "port": "3333"
            },
            "cmsis": {
                "cbuildRunFile": "${command:cmsis-csolution.getCbuildRunFile}",
                "updateConfiguration": "auto"
            }
        },
        {
            "name": "M55_HE JLink (attach)",
            "type": "gdbtarget",
            "request": "attach",
            "cwd": "${workspaceFolder}/",
            "program": "out/blinky/DevKit-E8-HE/debug/blinky.elf",
            "gdb": "arm-none-eabi-gdb",
            "auxiliaryGdb": true,
            "initCommands": [
                ""
            ],
            "customResetCommands": [
                "monitor reset 0",
                "maintenance flush register-cache",
                "maintenance flush dcache",
                "tbreak main",
                "continue"
            ],
            "target": {
                "port": "3333"
            },
            "cmsis": {
                "cbuildRunFile": "${command:cmsis-csolution.getCbuildRunFile}",
                "updateConfiguration": "auto"
            }
        },
        {
            "name": "M55_HP JLink (launch)",
            "type": "gdbtarget",
            "request": "launch",
            "cwd": "${workspaceFolder}/",
            "program": "",
            "gdb": "arm-none-eabi-gdb",
            "auxiliaryGdb": true,
            "initCommands": [
                ""
            ],
            "customResetCommands": [
                "monitor reset 0",
                "maintenance flush register-cache",
                "maintenance flush dcache",
                "tbreak main",
                "continue"
            ],
            "target": {
                "server": "JLinkGDBServerCL.exe",
                "serverParameters": [
                    "-device",
                    "AE822FA0E5597LS0_M55_HP",
                    "-endian",
                    "little",
                    "-if",
                    "swd",
                    "-speed",
                    "4000",
                    "-halt",
                    "-noir",
                    "-vd",
                    "-nogui",
                    "-localhostonly",
                    "-silent",
                    "-port",
                    "3334",
                    "-TelnetPort",
                    "4445"
                ],
                "port": "3334"
            },
            "cmsis": {
                "cbuildRunFile": "${command:cmsis-csolution.getCbuildRunFile}",
                "updateConfiguration": "auto"
            }
        }
    ]
}
